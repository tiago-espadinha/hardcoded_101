{
  "name": "@aurora-ds/storybook",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "styles:build": "tailwindcss -i src/styles/storybook.css -o src/styles/generated.css --config ../../tailwind.config.js",
    "dev": "pnpm styles:build && storybook dev -p 6006",
    "build": "pnpm styles:build && storybook build",
    "test:a11y": "test-storybook --url http://localhost:6006",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aurora-ds/components": "workspace:*",
    "@aurora-ds/icons": "workspace:*",
    "@aurora-ds/tokens": "workspace:*"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-links": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@storybook/test-runner": "^0.24.4",
    "@types/react": "^18.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^10.5.10",
    "tailwindcss": "^3.4.17",
    "vite": "^5.0.0",
    "@storybook/addon-docs": "^10.5.10",
    "@aurora-ds/eslint-config": "workspace:*",
    "eslint": "^8.57.0"
  }
}