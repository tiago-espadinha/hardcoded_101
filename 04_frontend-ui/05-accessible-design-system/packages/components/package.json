{
  "name": "@aurora-ds/components",
  "version": "0.1.0",
  "description": "Aurora DS React component library",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./primitives": "./src/primitives/index.ts",
    "./simple": "./src/simple/index.ts",
    "./composite": "./src/composite/index.ts",
    "./complex": "./src/complex/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --coverage",
    "test:a11y": "vitest run --reporter=verbose --coverage src/**/*.a11y.test.tsx",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@aurora-ds/icons": "workspace:*",
    "@aurora-ds/tokens": "workspace:*",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-context-menu": "^2.1.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^0.2.0"
  },
  "devDependencies": {
    "@aurora-ds/eslint-config": "workspace:*",
    "@aurora-ds/tsconfig": "workspace:*",
    "@axe-core/react": "^4.8.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.2.0",
    "@vitest/coverage-v8": "^1.0.0",
    "jest-axe": "^8.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
